{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Safe",
  "version": "0.2.0",
  "identifier": "dev.volchok.promptsafe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prompt Safe",
        "width": 1100,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Volchok",
    "shortDescription": "Scan prompts for secrets before pasting them into an AI agent",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Volchok",
    "category": "DeveloperTool",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
